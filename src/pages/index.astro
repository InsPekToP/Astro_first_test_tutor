---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';

const pageTitle = "Главная (index.astro)"
---

<BaseLayout pageTitle={pageTitle}>
  <h1>Привет из Главной</h1>
	<h1>"Это текст из pageTitle: {pageTitle}"</h1>
  <h2>h2 из компонента index.astro</h2>
  <Greeting messages={["Hi", "Hello", "Howdy", "Hey there"]} />
  <Greeting client:load messages={["Hej", "Hallo", "Hola", "Habari"]} />
</BaseLayout>


<!-- Весь HTML из index.astro перенесен в BaseLayout.astro -->


